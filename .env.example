# =============================================================================
# Connectivity (connectivity/adguard.yml, proxy.yml, twingate.yml)
# =============================================================================
ADGUARD_CONFIG=/opt/adguard
ADGUARD_WEB_PORT=8080
NPM_DATA=/opt/nginx-proxy-manager

# Twingate Connector (Host-spezifische Tokens aus Ansible Vault)
TWINGATE_NETWORK=
TWINGATE_ACCESS_TOKEN=
TWINGATE_REFRESH_TOKEN=

# =============================================================================
# Documents (documents/docker-compose.yml - raspberrypi)
# =============================================================================
PAPERLESS_DATA=/mnt/drive/paperless
PAPERLESS_DB_PASSWORD=paperless

# =============================================================================
# Media (media/docker-compose.yml - parents_pi)
# =============================================================================
PLEX_CONFIG=/opt/plex
OVERSEERR_CONFIG=/opt/overseerr
PLEX_TV_PATH=/mnt/mediahdd/Serien
PLEX_MOVIES_PATH=/mnt/mediahdd/Filme
PLEX_PICTURES_PATH=/mnt/oldhdd/Bilder

# =============================================================================
# Storage (storage/samba.yml)
# =============================================================================
SAMBA_DATA=/mnt/drive/nas
SAMBA_PASSWORD=

# =============================================================================
# Monitoring Agent (monitoring/agent.yml - raspberrypi & parents_pi)
# =============================================================================
ALLOY_DATA=/opt/alloy
MONITORING_HOSTNAME=raspberrypi
PROMETHEUS_REMOTE_WRITE_URL=https://prometheus.el-gartmanno.de/api/v1/write
PROMETHEUS_REMOTE_WRITE_USER=alloy
PROMETHEUS_REMOTE_WRITE_PASSWORD=

# =============================================================================
# Monitoring Server (monitoring/server.yml - strato_vps)
# =============================================================================
PROMETHEUS_DATA=/opt/prometheus
GRAFANA_DATA=/opt/grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=https://grafana.el-gartmanno.de
DISCORD_WEBHOOK_RASPBERRYPI=
DISCORD_WEBHOOK_PARENTS_PI=
DISCORD_WEBHOOK_STRATO_VPS=
